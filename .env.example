# Server
PORT=3000
HOST=0.0.0.0

# Public base URL used to build returned download URLs.
# Local dev:        http://localhost:3000
# Behind nginx/VPS: https://downloader.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Where downloaded files are stored (relative or absolute path)
DOWNLOAD_DIR=./downloads

# How long files are kept before being auto-deleted (in minutes)
FILE_TTL_MINUTES=60

# Max file size accepted from yt-dlp (in MB). Helps prevent abuse.
MAX_FILE_SIZE_MB=2048

# yt-dlp & ffmpeg binary paths.
# Leave as bare command names if both are on your system PATH — yt-dlp will
# discover ffmpeg itself in that case. Only set absolute paths (e.g.
# C:/ffmpeg/bin/ffmpeg.exe) when the binary is NOT on PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=60

# Optional simple API key. If set, clients must send `x-api-key: <value>`.
API_KEY=
